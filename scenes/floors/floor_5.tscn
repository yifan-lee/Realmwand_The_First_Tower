sprite_scale = Vector2(0.125, 0.125)
dialogue_lines = Array[String](["一座空荡荡的平台，上面曾经放着什么东西。", "灰尘上还残留着一行字迹。", "“东西我拿走了，不过不好用我又懒得放回原位，所以我随手扔在了类似的地方。”"])
